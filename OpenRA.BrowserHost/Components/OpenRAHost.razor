@using OpenRA
@using OpenRA.BrowserHost
@using OpenRA.FileSystem
@using OpenRA.Platforms.Browser
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@using System.Diagnostics
@using System.Linq
@using System.Runtime.InteropServices.JavaScript
@using System.Text.Json
@using System.Threading
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject IWebAssemblyHostEnvironment HostEnvironment

<div class="openra-host-shell">
    <canvas id="game-canvas" width="@_gpu.CanvasWidth" height="@_gpu.CanvasHeight" tabindex="0"
            class="openra-game-canvas"></canvas>

    @if (showLoadingOverlay)
    {
        <div class="openra-loading-overlay">
            <div class="openra-loading-card">
                <div class="openra-loading-title">Initializing OpenRA</div>
                <div class="openra-loading-subtitle">@loadingStatus</div>
                <div class="openra-loading-audio-hint">Click or tap anywhere to enable sound.</div>
                <div class="openra-loading-progress">
                    <div class="openra-loading-progress-indeterminate"></div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .openra-host-shell {
        position: fixed;
        inset: 0;
        margin: 0;
        background: #000;
        overflow: hidden;
        cursor: none;
        user-select: none;
        -webkit-user-select: none;
    }

    /* Canvas fills viewport exactly; JS syncs the bitmap (width/height attrs) to match so there is no crop and no letterbox. */
    .openra-game-canvas {
        cursor: none;
        outline: none;
        border: none;
        background: #000;
        display: block;
        width: 100vw;
        height: 100vh;
        height: 100dvh;
    }

    .openra-loading-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        padding: 18px;
        pointer-events: none;
        background: linear-gradient(180deg, rgba(0, 0, 0, 0.12), rgba(0, 0, 0, 0.45));
    }

    .openra-loading-card {
        width: min(92%, 560px);
        padding: 12px 14px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        background: rgba(12, 16, 24, 0.75);
        color: #e9edf5;
        box-shadow: 0 10px 22px rgba(0, 0, 0, 0.45);
    }

    .openra-loading-title {
        font-weight: 700;
        letter-spacing: 0.2px;
        margin-bottom: 2px;
    }

    .openra-loading-subtitle {
        font-size: 0.9rem;
        color: #bfc9d8;
        margin-bottom: 4px;
    }

    .openra-loading-audio-hint {
        font-size: 0.75rem;
        color: rgba(191, 201, 216, 0.78);
        margin-bottom: 8px;
        line-height: 1.35;
    }

    .openra-loading-progress {
        position: relative;
        height: 8px;
        overflow: hidden;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
    }

    .openra-loading-progress-indeterminate {
        position: absolute;
        top: 0;
        left: -35%;
        width: 35%;
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, #4ca8ff, #87d7ff);
        animation: openra-indeterminate 1.2s ease-in-out infinite;
    }

    @@keyframes openra-indeterminate {
        0% { left: -35%; }
        100% { left: 100%; }
    }
</style>

@code {
    bool showLoadingOverlay = true;
    string loadingStatus = "Preparing WebGL bridge...";

	BrowserHostGpuOptions _gpu;

	string ShellGpuCssVars => "";

	protected override void OnInitialized()
	{
		_gpu = BrowserHostGpuOptions.Resolve(NavigationManager.Uri);
		Console.WriteLine("[browser perf] canvas internal " + _gpu.CanvasWidth + "x" + _gpu.CanvasHeight +
			"; Graphics: " + string.Join(", ", _gpu.GraphicsLaunchArgs));
	}

	/// <summary>Query <c>supportOrigin</c>: absolute http(s) base URL where <c>support/Content/…</c> is hosted (CDN). Omit trailing slash.</summary>
	static string TryParseSupportAssetsBaseUrlFromQuery(string absoluteUri)
	{
		if (string.IsNullOrEmpty(absoluteUri) || !Uri.TryCreate(absoluteUri, UriKind.Absolute, out var pageUri))
			return null;
		var query = pageUri.Query;
		if (string.IsNullOrEmpty(query))
			return null;
		if (query[0] == '?')
			query = query.Length > 1 ? query[1..] : string.Empty;
		foreach (var segment in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
		{
			var eq = segment.IndexOf('=');
			var name = eq >= 0 ? segment[..eq] : segment;
			var value = eq >= 0 && eq + 1 <= segment.Length ? segment[(eq + 1)..] : string.Empty;
			if (!string.Equals(Uri.UnescapeDataString(name), "supportOrigin", StringComparison.OrdinalIgnoreCase))
				continue;
			var decoded = Uri.UnescapeDataString(value.Replace('+', ' ')).Trim();
			if (string.IsNullOrEmpty(decoded))
				return null;
			if (!Uri.TryCreate(decoded, UriKind.Absolute, out var u))
				return null;
			if (u.Scheme != Uri.UriSchemeHttp && u.Scheme != Uri.UriSchemeHttps)
				return null;
			return decoded;
		}

		return null;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender)
			return;

		BrowserWindowSettings.CanvasElementId = "game-canvas";

		var bootSw = Stopwatch.StartNew();
		var bootLastMs = 0L;
		void BootMark(string phase)
		{
			var t = bootSw.ElapsedMilliseconds;
			Console.WriteLine("[browser perf] host " + phase + "  +" + (t - bootLastMs) + "ms  (total " + t + "ms)");
			bootLastMs = t;
		}

		var viewportSize = await JS.InvokeAsync<int[]>("eval", new object[]
		{
			"[document.documentElement.clientWidth, document.documentElement.clientHeight, window.devicePixelRatio || 1]"
		});
		var vpCssW = viewportSize is { Length: >= 2 } && viewportSize[0] > 320 ? viewportSize[0] : _gpu.CanvasWidth;
		var vpCssH = viewportSize is { Length: >= 2 } && viewportSize[1] > 240 ? viewportSize[1] : _gpu.CanvasHeight;

		var argsList = new List<string>
		{
			"Engine.EngineDir=engine",
			"Engine.SupportDir=support",
			"Game.Mod=" + _gpu.BrowserGameMod
		};
		foreach (var arg in _gpu.GraphicsLaunchArgs)
		{
			if (arg.StartsWith("Graphics.WindowedSize=", StringComparison.Ordinal))
				continue;
			argsList.Add(arg);
		}
		argsList.Add($"Graphics.WindowedSize={vpCssW},{vpCssH}");
		if (!string.IsNullOrEmpty(_gpu.BrowserTunnelJoinUrl))
			argsList.Add("Browser.TunnelUrl=" + _gpu.BrowserTunnelJoinUrl);
		if (!string.IsNullOrEmpty(_gpu.BrowserTunnelEdgeToken))
			argsList.Add("Browser.TunnelEdgeToken=" + _gpu.BrowserTunnelEdgeToken);
		var args = argsList.ToArray();

		try
		{
			// JSImport WebGL bridge: module name must match WebGLInterop's JSImport module id; URL is served from wwwroot.
            loadingStatus = "Loading WebGL runtime...";
            await InvokeAsync(StateHasChanged);
			await JSHost.ImportAsync("js/openra-gl.js", "/js/openra-gl.js", CancellationToken.None);
			BootMark("openra-gl.js");
			await JSHost.ImportAsync("js/openra-audio.js", "/js/openra-audio.js", CancellationToken.None);
			BootMark("openra-audio.js");

            loadingStatus = "Booting engine and scanning mods...";
            await InvokeAsync(StateHasChanged);
			BrowserModAssemblyRoots.Touch();
			var baseUri = NavigationManager.BaseUri;
			if (string.IsNullOrWhiteSpace(baseUri))
				baseUri = HostEnvironment.BaseAddress;
			if (!baseUri.EndsWith("/", StringComparison.Ordinal))
				baseUri += "/";
			Game.WasmHttpOrigin = baseUri;
			Game.WasmSupportAssetsBaseUrl = TryParseSupportAssetsBaseUrlFromQuery(NavigationManager.Uri);
			BootMark("mod roots + WasmHttpOrigin");

			loadingStatus = "Preloading baked fonts (if any)...";
			await InvokeAsync(StateHasChanged);
			await PreloadBakedFontsAsync(baseUri);
			BootMark("preload baked fonts");

			loadingStatus = BrowserSupportPreloadStatusText(_gpu.BrowserGameMod);
			await InvokeAsync(StateHasChanged);
			await PreloadBrowserSupportAssetsAsync();
			BootMark("preload support Content assets");

			Game.BrowserInitialize(args);
			BootMark("Game.BrowserInitialize (through map prepare)");

			if (Game.BrowserMapContentsLoadPending)
			{
				loadingStatus = "Loading maps…";
				await InvokeAsync(StateHasChanged);
				await Game.BrowserCompleteMapLoadAsync();
				BootMark("Game.BrowserCompleteMapLoadAsync");
			}
		}
		catch (Exception ex)
		{
            loadingStatus = "Initialization failed (see browser console).";
            showLoadingOverlay = true;
            await InvokeAsync(StateHasChanged);
			Console.WriteLine("OpenRA BrowserInitialize failed: " + ex);
			return;
		}

		if (Game.BrowserModLoadAborted)
		{
			loadingStatus = BrowserModLoadFailedHelpText(_gpu.BrowserGameMod);
			showLoadingOverlay = true;
			await InvokeAsync(StateHasChanged);
			return;
		}

        loadingStatus = "Starting render loop...";
        await InvokeAsync(StateHasChanged);
		await JS.InvokeVoidAsync("browserOpenRA.start", "game-canvas");
		BootMark("browserOpenRA.start");
        showLoadingOverlay = false;
        await InvokeAsync(StateHasChanged);
	}

	async Task PreloadBakedFontsAsync(string originBase)
	{
		try
		{
			BrowserBakedFontStore.Clear();
			if (string.IsNullOrWhiteSpace(originBase))
				return;
			if (!originBase.EndsWith("/", StringComparison.Ordinal))
				originBase += "/";

			var manifestUri = new Uri(new Uri(originBase, UriKind.Absolute), "engine/baked-fonts/manifest.json");
			var json = await Http.GetStringAsync(manifestUri);
			using var doc = JsonDocument.Parse(json);
			if (!doc.RootElement.TryGetProperty("files", out var filesEl) || filesEl.ValueKind != JsonValueKind.Array)
				return;

			foreach (var el in filesEl.EnumerateArray())
			{
				if (el.ValueKind != JsonValueKind.String)
					continue;
				var name = el.GetString();
				if (string.IsNullOrEmpty(name))
					continue;

				var blobUri = new Uri(new Uri(originBase, UriKind.Absolute), "engine/baked-fonts/" + name);
				var bytes = await Http.GetByteArrayAsync(blobUri);
				BrowserBakedFontStore.RegisterOrbf(bytes);
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine("[browser] Baked font preload skipped: " + ex.Message);
		}
	}

	static string BrowserSupportPreloadStatusText(string modId)
	{
		if (string.Equals(modId, "ra", StringComparison.OrdinalIgnoreCase))
			return "Preloading required Red Alert support assets...";
		if (string.Equals(modId, "cnc", StringComparison.OrdinalIgnoreCase))
			return "Preloading required C&C (TD) support assets...";
		return "Preloading support assets (if applicable)...";
	}

	static string BrowserModLoadFailedHelpText(string modId)
	{
		if (string.Equals(modId, "ra", StringComparison.OrdinalIgnoreCase))
			return "Mod did not load: copy RA Content/ra/v2 into OpenRA.BrowserHost/wwwroot/support/Content/ra/v2/ (not in git; run copy-ra-content-to-browser.sh) or host the same tree elsewhere and open with ?supportOrigin=https://your-cdn.example.com/ (CORS required). See README.";
		if (string.Equals(modId, "cnc", StringComparison.OrdinalIgnoreCase))
			return "Mod did not load: copy TD content into wwwroot/support/Content/cnc/ (copy-cnc-content-to-browser.sh) or use ?supportOrigin= for a CDN mirror. If you only have RA data, use ?mod=ra.";
		return "Mod did not load: place game content under wwwroot/support/Content/… (see README) or set ?supportOrigin= to a host that mirrors that layout.";
	}

	async Task PreloadBrowserSupportAssetsAsync()
	{
		BrowserSupportHttpContent.ClearRaV2AssetCache();
		var origin = BrowserSupportHttpContent.EffectiveSupportAssetsOrigin();
		if (string.IsNullOrEmpty(origin))
			return;

		if (!TryGetBrowserSupportPreloadPlan(_gpu.BrowserGameMod, out var httpSubPath, out var preloadOrder, out var cacheVersion))
			return;

		const int maxConcurrent = 8;
		using var gate = new SemaphoreSlim(maxConcurrent);
		var tasks = preloadOrder
			.Select(relativePath => PreloadOneSupportAssetAsync(origin, httpSubPath, cacheVersion, relativePath, gate));
		await Task.WhenAll(tasks);
	}

	static bool TryGetBrowserSupportPreloadPlan(string modId, out string httpSubPath, out string[] preloadOrder, out string cacheVersion)
	{
		if (string.Equals(modId, "ra", StringComparison.OrdinalIgnoreCase))
		{
			httpSubPath = "support/Content/ra/v2";
			preloadOrder = BrowserSupportHttpContent.DefaultRaV2PreloadOrder;
			cacheVersion = BrowserSupportHttpContent.RaV2BrowserAssetCacheVersion;
			return true;
		}

		if (string.Equals(modId, "cnc", StringComparison.OrdinalIgnoreCase))
		{
			httpSubPath = "support/Content/cnc";
			preloadOrder = BrowserSupportHttpContent.DefaultCncPreloadOrder;
			cacheVersion = BrowserSupportHttpContent.CncBrowserAssetCacheVersion;
			return true;
		}

		httpSubPath = null;
		preloadOrder = null;
		cacheVersion = null;
		return false;
	}

	async Task PreloadOneSupportAssetAsync(string originBase, string httpSubPath, string cacheVersion, string relativePath, SemaphoreSlim gate)
	{
		await gate.WaitAsync();
		try
		{
			var uri = new Uri(new Uri(originBase, UriKind.Absolute), $"{httpSubPath}/{relativePath}");
			try
			{
				byte[]? fromDb = null;
				try
				{
					fromDb = await JS.InvokeAsync<byte[]?>("openraAssetCache.tryGet", cacheVersion, relativePath);
				}
				catch
				{
					// IndexedDB or interop unavailable; fall back to HTTP only.
				}

				if (fromDb != null && fromDb.Length > 0)
				{
					BrowserSupportHttpContent.CacheRaV2Asset(relativePath, fromDb);
					return;
				}

				var bytes = await Http.GetByteArrayAsync(uri);
				BrowserSupportHttpContent.CacheRaV2Asset(relativePath, bytes);
				_ = WriteSupportAssetToIndexedDbAsync(cacheVersion, relativePath, bytes);
			}
			catch (Exception ex)
			{
				Console.WriteLine($"[browser] Failed to preload support asset '{relativePath}': {ex.Message}");
			}
		}
		finally
		{
			gate.Release();
		}
	}

	async Task WriteSupportAssetToIndexedDbAsync(string cacheVersion, string relativePath, byte[] bytes)
	{
		try
		{
			await JS.InvokeVoidAsync("openraAssetCache.tryPut", cacheVersion, relativePath, bytes);
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[browser] IndexedDB put failed for '{relativePath}': {ex.Message}");
		}
	}
}
